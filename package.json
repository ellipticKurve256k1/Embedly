{
  "name": "embedly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env server/index.js",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 server/*.test.js server/**/*.test.js src/**/*.test.js",
    "test:server": "node --test --test-concurrency=1 server/*.test.js server/**/*.test.js",
    "test:services": "node --test server/services/*.test.js",
    "test:watch": "node --test --test-concurrency=1 --watch server/*.test.js server/**/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage server/*.test.js server/**/*.test.js",
    "test:verbose": "node --test --test-concurrency=1 server/*.test.js server/**/*.test.js 2>&1 | grep -E '(tests?|pass|fail)'",
    "test:filename": "node --test server/lib/filename.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "@xenova/transformers": "^2.0.1",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest"
  }
}
